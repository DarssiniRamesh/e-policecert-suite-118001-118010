[flake8]
# --- What to scan ---
exclude = .git,__pycache__,build,dist,venv

# --- What to report ---
#   E9  – syntax / indentation / parsing errors (from pycodestyle)
#   F   – undefined names, unused imports/variables, etc. (from pyflakes)
# Remove ‘E’, ‘W’, ‘C’, ‘B’, … if you truly want *only* syntax issues.
# Keep B (bugbear) if you still want likely-bug warnings.
select = E9,F

# --- Misc settings you may still want ---
max-line-length = 120
per-file-ignores =
    __init__.py:F401
max-complexity = 18
